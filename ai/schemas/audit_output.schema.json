{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DarkAudit Hybrid Audit Output v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "schema_version", "screens", "candidate_decisions", "semantic_findings"],
  "properties": {
    "audit_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.1"},
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/screen"}
    },
    "candidate_decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate_decision"}
    },
    "semantic_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/detection"}
    }
  },
  "$defs": {
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_id", "flow_step"],
      "properties": {
        "screen_id": {"type": "string", "minLength": 1},
        "flow_step": {"type": "string", "minLength": 1}
      }
    },
    "bbox": {
      "type": "array",
      "description": "[x, y, width, height] normalized to the screen, each value in 0..1",
      "items": {"type": "number", "minimum": 0, "maximum": 1},
      "minItems": 4,
      "maxItems": 4
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_ids", "element", "location"],
      "properties": {
        "screen_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "element": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "related_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_id", "element", "bbox"],
      "properties": {
        "screen_id": {"type": "string", "minLength": 1},
        "element": {"type": "string", "minLength": 1},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "candidate_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "decision", "reason", "confidence", "base_severity"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["KEEP", "REJECT"]},
        "reason": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "base_severity": {"enum": ["REVIEW", "HIGH"]}
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_type", "risk_name", "where", "bbox", "related_elements", "what",
        "observation", "rule_id", "why", "severity", "confidence", "fix"
      ],
      "properties": {
        "risk_type": {"enum": ["PRESELECTED_OPTION", "VISUAL_HIERARCHY_DISTORTION", "EMOTIONAL_LANGUAGE", "SEQUENTIAL_PRICE_DISCLOSURE"]},
        "risk_name": {"enum": ["특정옵션의 사전선택", "잘못된 계층구조", "감정적 언어", "순차공개 가격책정"]},
        "where": {"$ref": "#/$defs/where"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "related_elements": {"type": "array", "items": {"$ref": "#/$defs/related_element"}},
        "what": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "rule_id": {"enum": ["DA-03", "DA-04", "DA-12", "DA-15"]},
        "why": {"type": "string", "minLength": 1},
        "severity": {
          "enum": ["REVIEW", "HIGH"],
          "description": "Rule Base base_severity before combination or mitigation scoring"
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "fix": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"risk_type": {"const": "PRESELECTED_OPTION"}}},
          "then": {
            "properties": {
              "rule_id": {"const": "DA-04"},
              "risk_name": {"const": "특정옵션의 사전선택"},
              "severity": {"const": "HIGH"},
              "where": {"properties": {"screen_ids": {"maxItems": 1}}}
            }
          }
        },
        {
          "if": {"properties": {"risk_type": {"const": "VISUAL_HIERARCHY_DISTORTION"}}},
          "then": {
            "properties": {
              "rule_id": {"const": "DA-03"},
              "risk_name": {"const": "잘못된 계층구조"},
              "severity": {"const": "HIGH"},
              "where": {"properties": {"screen_ids": {"maxItems": 1}}},
              "related_elements": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"risk_type": {"const": "EMOTIONAL_LANGUAGE"}}},
          "then": {
            "properties": {
              "rule_id": {"const": "DA-12"},
              "risk_name": {"const": "감정적 언어"},
              "severity": {"const": "REVIEW"},
              "where": {"properties": {"screen_ids": {"maxItems": 1}}}
            }
          }
        },
        {
          "if": {"properties": {"risk_type": {"const": "SEQUENTIAL_PRICE_DISCLOSURE"}}},
          "then": {
            "properties": {
              "rule_id": {"const": "DA-15"},
              "risk_name": {"const": "순차공개 가격책정"},
              "severity": {"const": "HIGH"},
              "where": {"properties": {"screen_ids": {"minItems": 2}}}
            }
          }
        }
      ]
    }
  }
}
